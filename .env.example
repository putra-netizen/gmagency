# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where  this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase database configuration
# Connected live to Supabase Cloud
VITE_SUPABASE_URL=https://reonysrsoaepzykwwfzw.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJlb255c3Jzb2FlcHp5a3d3Znp3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODIzNzMyODIsImV4cCI6MjA5Nzk0OTI4Mn0.QABSWa2rmMrfLAgM88H2ELC4qZIEd33x76cZF8MgBVM
# Optional: Supabase Service Role Key (bypasses RLS on server-side)
SUPABASE_SERVICE_ROLE_KEY=

# Authentication & Session Security (JWT)
# Set a strong 64-character random string in your production environment
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# Bcrypt Password Hashes (Generate using: node scripts/hash-password.js <password>)
# Super Admin (Replace with your generated bcrypt hash)
ADMIN_PASSWORD_HASH=$2b$10$YourCustomAdminPasswordBcryptHashHereExampleOnly

# Admin SHP 1-4 (Replace with your generated bcrypt hashes)
ADMINSHP1_PASSWORD_HASH=$2b$10$YourCustomAdminShp1BcryptHashHereExampleOnly
ADMINSHP2_PASSWORD_HASH=$2b$10$YourCustomAdminShp2BcryptHashHereExampleOnly
ADMINSHP3_PASSWORD_HASH=$2b$10$YourCustomAdminShp3BcryptHashHereExampleOnly
ADMINSHP4_PASSWORD_HASH=$2b$10$YourCustomAdminShp4BcryptHashHereExampleOnly

# Finance PIN (Replace with your generated bcrypt hash)
FINANCE_PIN_HASH=$2b$10$YourCustomFinancePinBcryptHashHereExampleOnly

# Worker 1-8 (Optional worker accounts)
WORKER1_PASSWORD_HASH=$2b$10$YourCustomWorker1BcryptHashHereExampleOnly
WORKER2_PASSWORD_HASH=$2b$10$YourCustomWorker2BcryptHashHereExampleOnly
WORKER3_PASSWORD_HASH=$2b$10$YourCustomWorker3BcryptHashHereExampleOnly
WORKER4_PASSWORD_HASH=$2b$10$YourCustomWorker4BcryptHashHereExampleOnly
WORKER5_PASSWORD_HASH=$2b$10$YourCustomWorker5BcryptHashHereExampleOnly
WORKER6_PASSWORD_HASH=$2b$10$YourCustomWorker6BcryptHashHereExampleOnly
WORKER7_PASSWORD_HASH=$2b$10$YourCustomWorker7BcryptHashHereExampleOnly
WORKER8_PASSWORD_HASH=$2b$10$YourCustomWorker8BcryptHashHereExampleOnly


